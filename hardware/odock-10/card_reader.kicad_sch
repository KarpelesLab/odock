		(uuid "9805422c-bb09-5814-a81e-1b95897df661")
	)
	(text "  the Memory Stick insert input (0 = MS inserted). No card: CDZ high -> no MS, no WP. Card: low -> SD present, write enabled"
		(exclude_from_sim no)
		(at 200.66 182.88 0)
		(effects
