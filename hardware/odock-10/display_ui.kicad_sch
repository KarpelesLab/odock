	)
	(text "3.3 V LOGIC ONLY. 220R + ESD (TPD4E02B04 VRWM 3.6 V): 5 V is abuse, not a feature, even though the FT pads survive it."
		(exclude_from_sim no)
		(at 160.02 124.46 0)
