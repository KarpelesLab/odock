	)
	(text "HDR_P0..7 = RP2350 GPIO12..19: contiguous (PIO). FREE for the header: SPI1 (12-15), PWM6/7/0/1, PIO2, HSTX (not DVI:"
		(exclude_from_sim no)
		(at 160.02 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "61374345-0767-571e-94b4-88d8840b0b3f")
	)
	(text "  220R + ESD break TMDS). UART0 (debug), SPI0 (LCD), I2C0 (I2C_PD) and I2C1 (I2C_SYS) are already taken."
		(exclude_from_sim no)
		(at 160.02 121.92 0)
		(effects
