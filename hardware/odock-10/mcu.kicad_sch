	(text "1. RP2350B  QFN-80 10x10, 0.4 mm pitch, EP = GND (via array). All 48 GPIO allocated (table in docs/design/mcu.md)"
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left top)
		)
		(uuid "da789645-da4c-5f13-a26b-88e57d4228e7")
	)
	(text "2. POWER  +3V3 in; internal switching regulator makes +1V1 (DVDD). Copy the RPi minimal-board regulator layout exactly."
		(exclude_from_sim no)
		(at 20.32 33.02 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left top)
		)
		(uuid "b648e035-d2af-5c88-89f6-f688ffecf9c5")
	)
	(text "+1V1 is the RP2350 core (DVDD), made on-chip (VREG_LX -> L1001 -> VREG_FB/DVDD); it is not used elsewhere."
		(exclude_from_sim no)
		(at 20.32 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d734307a-4a10-5186-8f47-f57ba7bbc3af")
	)
	(text "L1001 ORIENTATION: dot = +1V1/C_OUT side (pad 2), as on the Pico 2 layout (DS Fig. 26); NOT toward VREG_LX. Rotated or"
		(exclude_from_sim no)
		(at 20.32 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0201426e-4289-5d9c-a30e-1d1c906a789d")
	)
	(text "  pin-swapped = worse regulation. Check the JLC CPL rotation/preview against the footprint dot before ordering."
		(exclude_from_sim no)
		(at 20.32 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ce00ba3a-1633-5a5c-b6e0-5bd11cc83da4")
	)
	(text "Second 4.7u on +1V1 sits at DVDD pin 32 (bottom edge of the package), not next to L1001/C_OUT."
		(exclude_from_sim no)
		(at 20.32 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9ce853b8-dc17-50e7-916e-0469f7faeab8")
	)
	(text "VREG_PGND: own via cluster, return the C6/C7 switching loop straight to pin 62 (RPi datasheet 'External components')."
		(exclude_from_sim no)
		(at 20.32 104.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5fe60535-61c9-52c7-a46a-bbfdccc9abb2")
	)
	(text "ADC_AVDD = +3V3 through 10R/4.7u: the ADC reference; NTC bias resistors hang on ADC_AVDD -> ratiometric."
		(exclude_from_sim no)
		(at 20.32 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "80b0f892-140a-5601-8771-5be153a1b384")
	)
	(text "Load: ~30-60 mA at 150 MHz both cores; < 0.2 W."
		(exclude_from_sim no)
		(at 20.32 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "365dbaf9-31be-51d9-9a47-eeed0bf9204a")
	)
	(text "3. CLOCK / QSPI FLASH / BOOTSEL / RUN / SWD"
		(exclude_from_sim no)
		(at 20.32 116.84 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left top)
		)
		(uuid "d48837b6-1149-5205-8436-0340ddb859a4")
	)
	(text "SWD pads (TP1001-TP1004, 1.0 mm, 2.54 mm apart): SWCLK, SWDIO, RUN, GND -> pogo jig or Raspberry Pi Debug Probe."
		(exclude_from_sim no)
		(at 20.32 198.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2b536db8-9b95-52fa-8868-0cff12b56902")
	)
	(text "BOOTSEL also recovers a hub stuck waiting for SMBus config: hold BOOTSEL + power-cycle -> HUB_SMB_PU stays low."
		(exclude_from_sim no)
		(at 20.32 200.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f8f1e37a-7e1a-5456-838b-5c8bdceb9c46")
	)
	(text "PMG1 SWD (GPIO26/27 -> 1k -> PMG1_SWCLK/SWDIO) + PMG1_XRES_N (GPIO28). FIRMWARE RULE: never assert PMG1_XRES_N, start a"
		(exclude_from_sim no)
		(at 20.32 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "99f5237f-8cf1-5d2b-93c4-262ab0b94d72")
	)
	(text "  PMG1 SWD session or enter the PMG1 I2C bootloader unless EXT_PWR_PRESENT = 1 (TCA9534 P0). Bus-powered, the PMG1 holds"
		(exclude_from_sim no)
		(at 20.32 205.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
