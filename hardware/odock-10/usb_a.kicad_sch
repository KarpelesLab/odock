		(uuid "63a5df71-f9cd-5b24-b347-69f544e359fb")
	)
	(text "  Hub-owned port: FAULT# pulls the node low -> hub reads overcurrent, latches the port off (drives low) -> OR output follows."
		(exclude_from_sim no)
		(at 20.32 205.74 0)
		(effects
			(font
				(size 1.27 1.27)
