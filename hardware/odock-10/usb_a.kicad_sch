		(uuid "178022b5-82eb-5f5b-9060-d72fa931b31b")
	)
	(text "  FAULT# (open drain, 7.5 ms deglitch) -> USBAx_OCS_N = same node as PWR_EN (0R on usb_hub). No pull-up on this node here."
		(exclude_from_sim no)
		(at 20.32 203.2 0)
		(effects
