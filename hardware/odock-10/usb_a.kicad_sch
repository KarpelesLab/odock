		(uuid "6d4b1efd-c75d-5dcf-a154-4550272d6add")
	)
	(text "  SSTX (pins 9/8). Device TX caps are inside the plugged device -> connector SSRX (pins 6/5) -> USBAx_SS_RX* -> hub RX with NO cap here."
		(exclude_from_sim no)
		(at 20.32 195.58 0)
		(effects
			(font
