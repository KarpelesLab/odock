	)
	(text "Port power: TPS2553 EN = USBAx_PWR_EN (hub PRT_CTL: ~50k internal pull-up = on, driven low = off) OR USBAx_FORCE_EN (RP2350)."
		(exclude_from_sim no)
		(at 20.32 200.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
