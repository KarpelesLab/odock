	(text "VBUS TVS SMCJ28A (1500 W SMC): VRWM 28 V, VBR 31.1-34.4 V @1 mA, VC 45.4 V @33 A. At 29.4 V (28 V EPR +5 %) it is ~2 V"
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
