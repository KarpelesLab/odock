		(uuid "aa568d71-767b-5dcc-ad51-0d2a2eb425e9")
	)
	(text "  during a surge (no TVS with VRWM >= 28 V can): accepted residual risk, same as Infineon's EPR references (VBUS_C direct)."
		(exclude_from_sim no)
