		(uuid "bf19f9e5-3d45-5bad-9894-9b64ad0ef2e4")
	)
	(text "  below VBR min -> leakage stays in the uA range (bench-check hot). It does NOT hold the PMG1 34 V abs-max pins below 34 V"
		(exclude_from_sim no)
		(at 20.32 27.94 0)
		(effects
